# Backend - Hotel Management System
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://admin:password123@postgres:5432/hotel_management
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=hotel_management

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=604800

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# CORS
CORS_ORIGIN=http://localhost:3000

# APIs
BOOKING_API_KEY=your-booking-api-key
AIRBNB_API_KEY=your-airbnb-api-key
EXPEDIA_API_KEY=your-expedia-api-key

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Logging
LOG_LEVEL=debug
